# 复制为 .dev.vars 后本地生效；部署时用 wrangler secret put 写入同名变量
# 用于对访客 IP 做加盐哈希（只存哈希，不存原始 IP），请改成足够长的随机串
IP_SALT="replace-with-a-long-random-string"

# 管理后台令牌。留空 = 关闭 /admin 与 /api/admin/*，建议线上开启
ADMIN_TOKEN=""

# 简单博客 SSO（可选）。BLOG_ORIGIN 填博客 API 的源，例如 https://api.starspace.cc
# BLOG_SSO_SECRET 用 openssl rand -hex 32 生成；仅用于一次性跳转令牌，不要复用其他密钥
BLOG_ORIGIN=""
BLOG_SSO_SECRET=""

# Cloudflare Turnstile（可选，强烈建议公开部署时开启）
# 两个都填才会在页面上出现人机验证
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
