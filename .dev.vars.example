# 复制为 .dev.vars 后本地生效；部署时敏感值用 wrangler secret put 写入同名变量
# 用于对访客 IP 做加盐哈希（只存哈希，不存原始 IP），请改成足够长的随机串
IP_SALT="replace-with-a-long-random-string"

# 管理员：令牌 / 用户名密码 / 通行密钥 / 博客 SSO，至少配置一种才会开启 /admin
ADMIN_TOKEN=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# 管理员会话签名密钥。留空时回退到 ADMIN_TOKEN 或 ADMIN_PASSWORD
SESSION_SECRET=""

# 简单博客 SSO（可选，默认关闭）。BLOG_ORIGIN 填博客 API 的源，例如 https://api.starspace.cc
# BLOG_SSO_SECRET 用 openssl rand -hex 32 生成；仅用于一次性跳转令牌，不要复用其他密钥
BLOG_ORIGIN=""
BLOG_SSO_SECRET=""
BLOG_SSO_ENABLED="false"

# Cloudflare Turnstile（可选，强烈建议公开部署时开启）
# 两个都填才会在页面上出现人机验证
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
