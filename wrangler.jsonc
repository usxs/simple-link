{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-link",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // 静态资源由 Worker 统一处理：/api/*、短码跳转、统计页、404 页都需要经过 Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // 这是给一键部署使用的可移植配置。
  // Cloudflare 会按 database_name 自动创建 D1，并把下面的占位 ID 替换成真实 ID。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simple-link",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // 每日清理过期短链与配额记录（UTC 03:41）
  "triggers": {
    "crons": ["41 3 * * *"]
  },

  "observability": {
    "enabled": true
  },

  // 一键部署不绑定自定义域名，先使用 Workers 分配的 *.workers.dev 地址。
  // 部署完成后可在控制台绑定域名，或参考 wrangler.production.jsonc 的写法。
  "vars": {
    "TIMEZONE": "Asia/Shanghai",
    "DAILY_LINK_LIMIT": "10",
    "ACTIVE_LINK_LIMIT": "30",
    "DEFAULT_TTL_DAYS": "365",
    "MAX_TTL_DAYS": "365",
    "TURNSTILE_SITE_KEY": "",
    "PUBLIC_ORIGIN": "",
    "BLOCKED_HOSTS": "",
    "SIBLING_URL": "",
    "BLOG_URL": "",
    "REPO_URL": "https://github.com/usxs/simple-link",
    "BLOG_ORIGIN": "",
    "BLOG_COOKIE_DOMAIN": "",
    "BLOG_SSO_ENABLED": "false"
  }
}
