{
  "name": "simple-link",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "简链 — 可部署在 Cloudflare Workers 的公益短链接服务",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply simple-link --remote",
    "db:migrate:local": "wrangler d1 migrations apply simple-link --local",
    "tail": "wrangler tail",
    "check": "wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
